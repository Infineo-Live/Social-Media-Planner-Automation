{
  "name": "infineo-social-media-planner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "clasp:login": "clasp login",
    "clasp:create": "clasp create --type webapp --title \"Infineo Social Media Planner API\" --rootDir apps-script",
    "clasp:push": "clasp push --rootDir apps-script",
    "clasp:deploy": "clasp deploy"
  },
  "overrides": {
    "uuid": "latest",
    "rimraf": "^4.0.0",
    "glob": "^9.0.0",
    "inflight": "^2.0.0"
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@google/clasp": "^3.3.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "happy-dom": "^20.11.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.1.4",
    "vitest": "^1.3.1"
  }
}
